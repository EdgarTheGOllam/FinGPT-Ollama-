# FinGPT Environment Variables
# Copy this file to .env and fill in your values

# AI Provider Settings
OLLAMA_URL=http://localhost:11434
AI_API_KEY=your_api_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# MetaTrader 5 Settings
MT5_LOGIN=your_login
MT5_PASSWORD=your_password
MT5_SERVER=your_server

# ==============================================================================
# NEWS API KEYS (News-Tab)
# ==============================================================================

# NewsAPI.org - Get free key at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Finnhub.io - Get free key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage - Get free key at https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=your_alphavantage_key_here
